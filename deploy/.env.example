# Copy to .env and fill in. .env stays on your computer: git ignores it.

# ---- Your computers -------------------------------------------------------------------------------------------
# The computer running this app (required)
WBS_HOST=192.168.1.10
# The computer running Home Assistant (required): clips come from it, and it is the MQTT broker unless set below
WBS_HA_HOST=192.168.1.20
# The computer running LM Studio. Leave empty to go without AI pre-labels.
WBS_AI_HOST=192.168.1.30

# ---- Folders and user -----------------------------------------------------------------------------------------
# The folders must exist. Keep the database on a local disk; images and clips can be on a NAS.
WBS_DATA_PATH=./data
WBS_IMAGE_PATH=./images
# The user and group that own those folders (run: id). WBS_EXTRA_GID is one more group, for a NAS share that needs it.
WBS_UID=1000
WBS_GID=1000
WBS_EXTRA_GID=1000
# Set to rslave if WBS_IMAGE_PATH is an automounted share
WBS_IMAGE_PROPAGATION=rprivate
TZ=America/Toronto

# ---- Web ------------------------------------------------------------------------------------------------------
WBS_PORT=8095
# Password for the Settings area (/admin). The kids page at / needs none.
WBS_ADMIN_PASSWORD=
# More host names the app answers to, comma separated (WBS_HOST and localhost always work). Others get a 400.
WBS_ALLOWED_HOSTS=
# The address sent in links, if not http://WBS_HOST:WBS_PORT. Behind a proxy, see "Under a path" in the README.
WBS_PUBLIC_URL=

# ---- Names ----------------------------------------------------------------------------------------------------
# Docker's names for the image and container
WBS_IMAGE=unsubscribird:latest
WBS_CONTAINER=unsubscribird
# Home Assistant's device id and MQTT topic. Pick once: changing them later makes new entities.
WBS_HA_ID=unsubscribird
WBS_HA_TOPIC=unsubscribird

# ---- MQTT and services ----------------------------------------------------------------------------------------
# Only if the broker isn't on WBS_HA_HOST
WBS_MQTT_HOST=
WBS_MQTT_PORT=1883
WBS_MQTT_USER=
WBS_MQTT_PASSWORD=
WBS_BRIDGE_TOPIC=vicohome_mqtt
# Only if these aren't on the usual ports (http://WBS_HA_HOST:8123 and http://WBS_AI_HOST:1234)
WBS_HA_URL=
WBS_LMSTUDIO_URL=
# LM Studio (OpenAI-compatible API). Leave the model empty to use whichever vision model is loaded.
WBS_LMSTUDIO_MODEL=
# true = never make LM Studio load or swap a model; wait until a vision model is loaded
WBS_LMSTUDIO_REQUIRE_LOADED=true

# Preferences: starting values and fallback. A value saved on the Settings page (/admin/settings) beats these;
# "default" on that page, or losing the database, comes back to them. The page doesn't write to this file.
# The name on every page
WBS_SITE_NAME=un-subscribird
# Kids' page: clip order (new, old, bird); theme for all pages (auto, light, dark)
WBS_KIDS_SORT=new
WBS_THEME=auto
# Cut the camera's dark wake-up off each new clip, once, in place, before frames are picked: at the first
# keyframe at or after this many seconds, with no re-encode (the camera's keyframes are 2 s apart). 0 = off.
WBS_CLIP_SKIP_SECONDS=2
# Delete the clip of a visit you confirmed as Empty this many days after the visit (frames and labels stay). 0 = keep.
WBS_EMPTY_CLIP_DAYS=14
WBS_FRAMES_PER_VISIT=4
WBS_PRELABEL_FRAMES=3
# true = stop using LM Studio, to free its GPU. New visits wait and catch up when you resume.
WBS_PRELABEL_PAUSED=false
# Clips with less movement than this are suggested as Empty and skip LM Studio
WBS_QUIET_ACTIVITY=0.025
# Recognition: trust the model / LM Studio from these confidences; wait this long for LM Studio (no wait when the
# model is at least WBS_HA_MODEL_INSTANT sure; 1 = always wait); ignore older visits
WBS_HA_MODEL_CONFIDENCE=0.75
WBS_HA_VLM_CONFIDENCE=0.8
WBS_HA_WAIT_VLM_S=600
WBS_HA_MODEL_INSTANT=0.98
WBS_HA_MAX_AGE_H=6
# Automatic retrain
WBS_AUTO_TRAIN=true
WBS_AUTO_TRAIN_HOUR=2
# Retrain every this many days (1 = every night), counted from the last model trained
WBS_AUTO_TRAIN_DAYS=1
WBS_AUTO_TRAIN_MIN_NEW=5
# Location: told to LM Studio; the pages are light from sunrise to sunset here
WBS_REGION=Ottawa, Ontario, Canada
WBS_LAT=45.42
WBS_LON=-75.70
