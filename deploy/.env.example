# Copy to .env and fill in. .env stays on your computer: git ignores it.

# ---- Your computers -------------------------------------------------------------------------------------------
# The computer running this app (required)
UNSUB_HOST=192.168.1.10
# The computer running Home Assistant (required): clips come from it, and it is the MQTT broker unless set below
UNSUB_HA_HOST=192.168.1.20
# The computer running LM Studio. Leave empty to go without AI pre-labels.
UNSUB_AI_HOST=192.168.1.30

# ---- Folders and user -----------------------------------------------------------------------------------------
# The folders must exist. Keep the database on a local disk; images and clips can be on a NAS.
UNSUB_DATA_PATH=./data
UNSUB_IMAGE_PATH=./images
# The user and group that own those folders (run: id). UNSUB_EXTRA_GID is one more group, for a NAS share that needs it.
UNSUB_UID=1000
UNSUB_GID=1000
UNSUB_EXTRA_GID=1000
# Set to rslave if UNSUB_IMAGE_PATH is an automounted share
UNSUB_IMAGE_PROPAGATION=rprivate
TZ=America/Toronto

# ---- Web ------------------------------------------------------------------------------------------------------
UNSUB_PORT=8095
# Password for the Settings area (/admin). The kids page at / needs none.
UNSUB_ADMIN_PASSWORD=
# More host names the app answers to, comma separated (UNSUB_HOST and localhost always work). Others get a 400.
UNSUB_ALLOWED_HOSTS=
# The address sent in links, if not http://UNSUB_HOST:UNSUB_PORT. Behind a proxy, see "Under a path" in the README.
UNSUB_PUBLIC_URL=

# ---- Names ----------------------------------------------------------------------------------------------------
# Docker's names for the image and container
UNSUB_IMAGE=unsubscribird:latest
UNSUB_CONTAINER=unsubscribird
# Home Assistant's device id and MQTT topic. Pick once: changing them later makes new entities.
UNSUB_HA_ID=unsubscribird
UNSUB_HA_TOPIC=unsubscribird

# ---- MQTT and services ----------------------------------------------------------------------------------------
# Only if the broker isn't on UNSUB_HA_HOST
UNSUB_MQTT_HOST=
UNSUB_MQTT_PORT=1883
UNSUB_MQTT_USER=
UNSUB_MQTT_PASSWORD=
UNSUB_BRIDGE_TOPIC=vicohome_mqtt
# Only if these aren't on the usual ports (http://UNSUB_HA_HOST:8123 and http://UNSUB_AI_HOST:1234)
UNSUB_HA_URL=
UNSUB_LMSTUDIO_URL=
# LM Studio (OpenAI-compatible API). Leave the model empty to use whichever vision model is loaded.
UNSUB_LMSTUDIO_MODEL=
# true = never make LM Studio load or swap a model; wait until a vision model is loaded
UNSUB_LMSTUDIO_REQUIRE_LOADED=true

# Preferences: starting values and fallback. A value saved on the Settings page (/admin/settings) beats these;
# "default" on that page, or losing the database, comes back to them. The page doesn't write to this file.
# The name on every page
UNSUB_SITE_NAME=un-subscribird
# Kids' page: clip order (new, old, bird); theme for all pages (auto, light, dark)
UNSUB_KIDS_SORT=new
UNSUB_THEME=auto
# Cut the camera's dark wake-up off each new clip, once, in place, before frames are picked: at the first
# keyframe at or after this many seconds, with no re-encode (the camera's keyframes are 2 s apart). 0 = off.
UNSUB_CLIP_SKIP_SECONDS=2
# Delete the clip of a visit you confirmed as Empty this many days after the visit (frames and labels stay). 0 = keep.
UNSUB_EMPTY_CLIP_DAYS=14
UNSUB_FRAMES_PER_VISIT=4
UNSUB_PRELABEL_FRAMES=3
# true = stop using LM Studio, to free its GPU. New visits wait and catch up when you resume.
UNSUB_PRELABEL_PAUSED=false
# Clips with less movement than this are suggested as Empty and skip LM Studio
UNSUB_QUIET_ACTIVITY=0.025
# Recognition: trust the model / LM Studio from these confidences; wait this long for LM Studio (no wait when the
# model is at least UNSUB_HA_MODEL_INSTANT sure; 1 = always wait); ignore older visits
UNSUB_HA_MODEL_CONFIDENCE=0.75
UNSUB_HA_VLM_CONFIDENCE=0.8
UNSUB_HA_WAIT_VLM_S=600
UNSUB_HA_MODEL_INSTANT=0.98
UNSUB_HA_MAX_AGE_H=6
# Automatic retrain
UNSUB_AUTO_TRAIN=true
UNSUB_AUTO_TRAIN_HOUR=2
# Retrain every this many days (1 = every night), counted from the last model trained
UNSUB_AUTO_TRAIN_DAYS=1
UNSUB_AUTO_TRAIN_MIN_NEW=5
# Patterns page: a Home Assistant temperature sensor (or weather entity) sampled every 10 minutes, read with a
# long-lived token (HA profile page, Security tab). Leave both empty to skip temperature.
UNSUB_TEMP_SENSOR=
UNSUB_HA_TOKEN=
# Hours without a bird, at a usually busy time of day, before HA's "Feeder quiet" sensor turns on (0 = off)
UNSUB_FEEDER_QUIET_H=3
# Location: told to LM Studio; the pages are light from sunrise to sunset here
UNSUB_REGION=Ottawa, Ontario, Canada
# eBird checklists (Patterns page): your location's name in eBird, eBird's region codes, stationary or incidental
UNSUB_EBIRD_LOCATION=Bird feeder
UNSUB_EBIRD_STATE=ON
UNSUB_EBIRD_COUNTRY=CA
UNSUB_EBIRD_PROTOCOL=stationary
UNSUB_LAT=45.42
UNSUB_LON=-75.70
